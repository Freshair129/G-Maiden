{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gmaiden:gann-store-release:1",
  "title": "GANN Store Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "version",
        "algorithm",
        "key_id",
        "issuer",
        "release_id",
        "publisher_id",
        "item_id",
        "announcer_id",
        "revision",
        "container_sha256",
        "container_bytes",
        "expanded_bytes",
        "compression_profile",
        "issued_at"
      ],
      "properties": {
        "format": {
          "const": "gann-store-release"
        },
        "version": {
          "const": 1
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "issuer": {
          "const": "gstore"
        },
        "release_id": {
          "$ref": "#/$defs/uuid"
        },
        "publisher_id": {
          "$ref": "#/$defs/uuid"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "announcer_id": {
          "type": "string",
          "pattern": "^ann_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "container_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "container_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "expanded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "compression_profile": {
          "const": "gann-zip-1"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
