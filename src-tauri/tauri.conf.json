{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-Maiden",
  "version": "0.13.4",
  "identifier": "com.gmaiden.desktop",
  "build": {
    "beforeBuildCommand": "node src-tauri/scripts/stage-gpu-feeder.mjs && pnpm -C src build",
    "beforeDevCommand": "node src-tauri/scripts/stage-gpu-feeder.mjs && pnpm -C src dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "gen/web"
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "$CONFIG/com.gmaiden.app",
      "data": "$DATA/com.gmaiden.app",
      "localData": "$LOCALDATA/com.gmaiden.app",
      "cache": "$CACHE/com.gmaiden.app",
      "log": "$LOCALDATA/com.gmaiden.app/logs"
    },
    "windows": [
      {
        "title": "G-Maiden",
        "label": "control",
        "create": false,
        "width": 1200,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "center": true,
        "visible": true,
        "transparent": true
      },
      {
        "title": "G-Maiden Overlay",
        "label": "overlay",
        "create": false,
        "width": 1280,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; frame-src 'none'; connect-src 'self' http://localhost:* ws://localhost:* https://api.opendota.com https://wsseitulmcgnolgsrxgh.supabase.co; script-src 'self' 'wasm-unsafe-eval' http://localhost:*; img-src 'self' data: https://cdn.cloudflare.steamstatic.com; media-src 'self' data: http://g-announcer-video.localhost g-announcer-video:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/gpu-feeder"
    ],
    "resources": {
      "vrzo-mixed": "vrzo-mixed",
      "../models/minimap-detector.onnx": "models/minimap-detector.onnx",
      "../models/labels.json": "models/labels.json",
      "voice-pack-default": "voice-pack-default",
      "../assets/voice-cache": "voice-cache"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/Freshair129/G-Maiden/main/release/channels/{{target}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNkE0NDgwOTcyOTk0MwpSV1JEbVhJSlNLUTJDYjVMNXRESEpvcDlVKzFiTllWQmxKSnJlSzliQ2p3dXY4aUVxR0lrY2VyQwo="
    }
  }
}
