{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-Maiden",
  "version": "0.1.0",
  "identifier": "com.gmaiden.app",
  "build": {
    "beforeBuildCommand": "pnpm -C src build",
    "beforeDevCommand": "pnpm -C src dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "gen/web"
  },
  "app": {
    "windows": [
      {
        "title": "G-Maiden",
        "label": "control",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      },
      {
        "title": "G-Maiden Overlay",
        "label": "overlay",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; script-src 'self' 'wasm-unsafe-eval' http://localhost:*; img-src 'self' data:; media-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../models/minimap-detector.onnx": "models/minimap-detector.onnx",
      "../models/labels.json": "models/labels.json"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Freshair129/G-Maiden/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNkE0NDgwOTcyOTk0MwpSV1JEbVhJSlNLUTJDYjVMNXRESEpvcDlVKzFiTllWQmxKSnJlSzliQ2p3dXY4aUVxR0lrY2VyQwo="
    }
  }
}
