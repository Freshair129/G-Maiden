.claude/

# Node
node_modules/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Rust
/src-tauri/target/
# nested sub-project Tauri/Rust build output (e.g. tools/audio-slicer/src-tauri/target)
**/src-tauri/target/
# any other standalone Cargo crate build output (e.g. tests/perf/target)
**/target/
# staged gpu-feeder sidecar binary (built by scripts/stage-gpu-feeder.mjs)
/src-tauri/binaries/
**/src-tauri/gen/
*.rs.bk

# Nested Cargo.lock files for standalone/nested crates (src-tauri/Cargo.lock is tracked, not ignored)
gpu-feeder/Cargo.lock
orchestration/src-tauri/Cargo.lock
tests/perf/Cargo.lock

# Tauri build output (vite -> gen/web) + icon source scratch
/src-tauri/gen/
/src-tauri/app-icon.png
/src-tauri/gen-icon.mjs

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python (CV tooling)
__pycache__/
*.pyc
.pytest_cache/

# Generated datasets (large, regenerable from gen-dataset)
tools/**/_ds/
tools/**/_smoke_ds/
_ds/

# OS
.DS_Store
Thumbs.db

# Tauri updater signing keys (NEVER commit the private key)
.tauri/
