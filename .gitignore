.claude/

# Node
node_modules/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Rust
/src-tauri/target/
# nested sub-project Tauri/Rust build output (e.g. tools/audio-slicer/src-tauri/target)
**/src-tauri/target/
# any other standalone Cargo crate build output (e.g. tests/perf/target)
**/target/
# staged gpu-feeder sidecar binary (built by scripts/stage-gpu-feeder.mjs)
/src-tauri/binaries/
**/src-tauri/gen/
*.rs.bk

# Nested Cargo.lock files for standalone/nested crates (src-tauri/Cargo.lock is tracked, not ignored)
gpu-feeder/Cargo.lock
orchestration/src-tauri/Cargo.lock
tests/perf/Cargo.lock

# Tauri build output (vite -> gen/web) + icon source scratch
/src-tauri/gen/
/src-tauri/app-icon.png
/src-tauri/gen-icon.mjs

# IDE
.vscode/
.idea/
*.swp
*.swo

# Local agent scratch and verification artifacts
.tmp/
.codex-artifacts/

# Python (CV tooling)
__pycache__/
*.pyc
.pytest_cache/

# Generated datasets (large, regenerable from gen-dataset)
tools/**/_ds/
tools/**/_smoke_ds/
_ds/

# OS
.DS_Store
Thumbs.db

# Tauri updater signing keys (NEVER commit the private key)
.tauri/

# Announcer packs that G-AnnStudio installs during development. `install_gmaiden_pack`
# resolves this repo as its target (resolve_gmaiden_dir -> dev sibling), so every test
# install drops a pack_<id>/ of wavs + webp banners straight into the working tree.
# Only the committed sample pack belongs in git; the rest is generated output.
# NOT ignored, deliberately: assets/voice-cache/{advice,danger,death,kill,...}/ are the
# legacy flat fallback chain the app ships with (see CLAUDE.md), and active-pack.txt.
/assets/voice-cache/packs/*
!/assets/voice-cache/packs/pack_mrijgajn/
